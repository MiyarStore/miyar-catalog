# منفذ التشغيل
PORT=3000
# الرابط العام للموقع بعد النشر (يُستخدم في رموز QR)
PUBLIC_URL=https://app.miyar.store
# مجلد حفظ قاعدة البيانات والمرفقات (لازم يكون على قرص دائم)
DATA_DIR=/data
# بريد صاحب المتجر (يفتح له لوحة الإدارة وتوليد الأكواد)، ويقبل أكثر من بريد بفاصلة
ADMIN_EMAILS=
# مفتاح Claude لتفعيل المساعد الذكي (بدونه يعمل بالقوالب الجاهزة)
ANTHROPIC_API_KEY=
# نموذج الذكاء الاصطناعي
AI_MODEL=claude-opus-5-5
# رابط صفحة شراء كود التفعيل في متجر سلة
STORE_URL=https://miyar.store
# أيام التجربة المجانية وحد استخدام المساعد اليومي لكل مستخدم
TRIAL_DAYS=7
AI_DAILY_LIMIT=40
NODE_ENV=production

# أسعار الباقات بالريال (تظهر في الصفحة الرئيسية وصفحة الاشتراك)
PRICE_MONTH=19
PRICE_TERM=39
PRICE_YEAR=59
